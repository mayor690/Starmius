# Public site URL (used for metadata and Paystack callback)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Session signing secret. Generate with: openssl rand -base64 32
AUTH_SECRET=

# Google login (OAuth Web client ID, safe to expose by design)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Paystack secret key (server only, never prefix with NEXT_PUBLIC_)
PAYSTACK_SECRET_KEY=

# Owner dashboard at /admin. Choose a long, unique password (12+ characters). Only you should know it.
ADMIN_PASSWORD=

# Optional. Folder for the catalogue, settings and uploaded images (default: ./storage). Use persistent disk.
DATA_DIR=
