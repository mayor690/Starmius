{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "starmius",
  "compatibility_date": "2026-01-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      // Must match the "name" above.
      "binding": "WORKER_SELF_REFERENCE",
      "service": "starmius"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  // Saved shop data. Wrangler creates these on the first deploy when no id is given.
  "d1_databases": [
    { "binding": "DB", "database_name": "starmius-db" }
  ],
  "r2_buckets": [
    { "binding": "UPLOADS", "bucket_name": "starmius-uploads" }
  ],
  "observability": {
    "enabled": true
  }
}
